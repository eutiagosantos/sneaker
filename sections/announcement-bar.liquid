{%- if section.settings.text != blank -%}
  <div class="announcement-bar" role="region" aria-label="{{ section.settings.text | escape }}">
    <div class="page-width announcement-bar__inner">
      {%- if section.settings.link != blank -%}
        <a class="announcement-bar__link" href="{{ section.settings.link }}">{{ section.settings.text }}</a>
      {%- else -%}
        <p class="announcement-bar__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.announcement-bar.settings.text.label",
      "default": "Frete grátis em pedidos acima de R$ 499"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.announcement-bar.settings.link.label"
    }
  ]
}
{% endschema %}
