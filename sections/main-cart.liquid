<div class="cart page-width section-spacing">
  <h1 class="cart__title">{{ 'cart.general.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <div class="empty-state">
      <p>{{ 'cart.general.empty' | t }}</p>
      <a class="button button--dark" href="{{ routes.all_products_collection_url }}">
        {{ 'general.continue_shopping' | t }}
      </a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart__form">
      <div class="cart__items">
        {%- for item in cart.items -%}
          <div class="cart-item">
            <a class="cart-item__media" href="{{ item.url }}">
              {%- if item.image -%}
                {{
                  item.image
                  | image_url: width: 200
                  | image_tag: loading: 'lazy', class: 'cart-item__image', alt: item.image.alt
                }}
              {%- endif -%}
            </a>

            <div class="cart-item__details">
              <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="cart-item__variant">{{ item.variant.title }}</p>
              {%- endunless -%}
              <p class="cart-item__price">{{ item.final_line_price | money }}</p>
              <a class="cart-item__remove" href="{{ item.url_to_remove }}">{{ 'cart.general.remove' | t }}</a>
            </div>

            <div class="cart-item__qty">
              <label class="visually-hidden" for="updates_{{ item.key }}">{{ 'cart.general.quantity' | t }}</label>
              <input
                id="updates_{{ item.key }}"
                type="number"
                name="updates[]"
                value="{{ item.quantity }}"
                min="0"
                class="product-form__qty"
              >
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="cart__footer">
        <div class="cart__subtotal">
          <span>{{ 'cart.general.subtotal' | t }}</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>
        <div class="cart__actions">
          <button type="submit" name="update" class="button button--light-outline">
            {{ 'cart.general.update' | t }}
          </button>
          <button type="submit" name="checkout" class="button button--dark">
            {{ 'cart.general.checkout' | t }}
          </button>
        </div>
      </div>
    </form>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main-cart.name",
  "settings": []
}
{% endschema %}
