<section class="category-cards section-spacing">
  <div class="page-width">
    <div class="category-cards__grid">
      {%- for block in section.blocks -%}
        <a
          class="category-card"
          href="{{ block.settings.link | default: '#' }}"
          {{ block.shopify_attributes }}
        >
          <div class="category-card__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 400
                | image_tag:
                  loading: 'lazy',
                  widths: '160, 240, 320, 400',
                  sizes: '(min-width: 990px) 140px, 28vw',
                  class: 'category-card__image',
                  alt: block.settings.title
              }}
            {%- else -%}
              <div class="category-card__placeholder" aria-hidden="true"></div>
            {%- endif -%}
          </div>
          {%- if block.settings.title != blank -%}
            <span class="category-card__title">{{ block.settings.title }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.category-cards.name",
  "tag": "section",
  "class": "section-category-cards",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "category",
      "name": "t:sections.category-cards.blocks.category.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.category-cards.blocks.category.settings.image.label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.category-cards.blocks.category.settings.title.label",
          "default": "Lifestyle"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.category-cards.blocks.category.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.category-cards.name",
      "blocks": [
        { "type": "category", "settings": { "title": "Lifestyle" } },
        { "type": "category", "settings": { "title": "Performance" } },
        { "type": "category", "settings": { "title": "Basquete" } },
        { "type": "category", "settings": { "title": "Slides" } }
      ]
    }
  ]
}
{% endschema %}
